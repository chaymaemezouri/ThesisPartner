#!/bin/sh
# Install only AFTER inspecting the current `deploy` command on the VPS.
# GitHub runs: ssh user@host "deploy $SHA"
#
# 1. type deploy; command -v deploy; cat "$(command -v deploy)"
# 2. Copy that file aside (deploy.previous).
# 3. Set THESIS_APP_DIR to the git checkout that contains docker-compose.yml.
# 4. Install this file as the `deploy` executable on PATH for the SSH user.
set -eu
: "${THESIS_APP_DIR:?set THESIS_APP_DIR to the ThesisPartner git checkout}"
cd "$THESIS_APP_DIR"
exec bash "$THESIS_APP_DIR/infrastructure/deploy/deploy.sh" "$1"
