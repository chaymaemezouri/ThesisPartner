# Copy to `.env` on the VPS next to docker-compose.yml. Do not commit the filled file.
NODE_ENV=production
APP_URL=https://YOUR_PUBLIC_DOMAIN
TRUST_PROXY=true
LOG_LEVEL=info

# External SMTP only. Mailpit is not a production mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Thesis Flow <noreply@YOUR_PUBLIC_DOMAIN>"

# API talks to SeaweedFS on the Docker network. Browsers use S3_PUBLIC_URL (same origin as APP_URL).
S3_ENDPOINT=http://s3:8333
S3_PUBLIC_URL=https://YOUR_PUBLIC_DOMAIN
S3_REGION=us-east-1
S3_BUCKET=thesispartner
S3_ACCESS_KEY=thesispartner
S3_SECRET_KEY=thesispartner-secret
S3_FORCE_PATH_STYLE=true
FILE_SCAN_MODE=allow
MAX_UPLOAD_SIZE_MB=50
SIGNED_URL_TTL_SECONDS=300

DATABASE_URL=postgresql://thesispartner:thesispartner@postgres:5432/thesispartner?schema=public
REDIS_URL=redis://redis:6379
PAYMENT_PROVIDER=none
