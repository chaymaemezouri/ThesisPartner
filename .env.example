# Copy to .env at the repository root. These values are for local development only.
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
DATABASE_URL=postgresql://thesispartner:thesispartner@localhost:5432/thesispartner?schema=public
TEST_DATABASE_URL=postgresql://thesispartner:thesispartner@localhost:5432/thesispartner_test?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TRUST_PROXY=false
# Development defaults to 127.0.0.1 (Mailpit). Production must set a real SMTP host.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="Thesis Flow <noreply@thesispartner.local>"
# Local SeaweedFS/MinIO. S3_PUBLIC_URL is the browser-reachable origin for signed downloads.
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=thesispartner
S3_ACCESS_KEY=thesispartner
S3_SECRET_KEY=thesispartner-secret
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=50
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_TTL_MS=60000
FILE_SCAN_MODE=stub
# Production without ClamAV: FILE_SCAN_MODE=allow (CLEAN except EICAR).
# Optional. Email of an existing account to promote as the first SUPER_ADMIN (no public signup).
# Leave empty after bootstrap. Registration never grants SUPER_ADMIN.
SUPER_ADMIN_BOOTSTRAP_EMAIL=
# Payment simulation (never use mock in production).
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
MOCK_PAYMENT_SCENARIO=success
