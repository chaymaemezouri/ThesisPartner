# Copy to .env at the repository root. These values are for local development only.
NODE_ENV=development
APP_URL=http://localhost:5173
API_PORT=3000
DATABASE_URL=postgresql://thesispartner:thesispartner@localhost:5432/thesispartner?schema=public
TEST_DATABASE_URL=postgresql://thesispartner:thesispartner@localhost:5432/thesispartner_test?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
TRUST_PROXY=false
# Optional. Mailpit in Docker Compose is mailpit:1025 from the API container, localhost:1025 from the host.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=ThesisPartner <noreply@thesispartner.local>
# Local MinIO only. Replace these before any shared or production deployment.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=thesispartner
S3_ACCESS_KEY=thesispartner
S3_SECRET_KEY=thesispartner-secret
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=50
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_TTL_MS=60000
FILE_SCAN_MODE=stub
